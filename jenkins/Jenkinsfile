pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent
spec:
  containers:
  - name: jnlp
    image: jenkins/inbound-agent:latest
    args:
    - $(JENKINS_SECRET)
    - $(JENKINS_NAME)

  - name: python
    image: python:3.12-slim
    command:
    - cat
    tty: true

  - name: docker
    image: docker:27.1.1-dind
    env:
    - name: DOCKER_TLS_CERTDIR
      value: ""
    securityContext:
      privileged: true
    command:
    - dockerd
    args:
    - --host=unix:///var/run/docker.sock
    - --host=tcp://0.0.0.0:2375
    - --storage-driver=vfs
    tty: true
'''
        }
    }

    environment {
        APP_DIR = "app"
        IMAGE_REPO = "prashant260/mew-app"
        IMAGE_TAG = "${BUILD_NUMBER}"
        DOCKER_CREDENTIALS_ID = "dockerhub"
        GITHUB_CREDENTIALS_ID = "github"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Debug Workspace') {
            steps {
                container('python') {
                    sh '''
                    echo "WORKSPACE=$WORKSPACE"
                    pwd
                    ls -la
                    echo "Repository Tree"
                    find . -maxdepth 3
                    '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                container('python') {
                    dir(env.APP_DIR) {
                        sh '''
                        set -ex
                        pwd
                        ls -la

                        rm -rf .venv
                        rm -rf venv

                        python3 -m venv .venv
                        . .venv/bin/activate
                        python -m pip install --upgrade pip
                        pip install -r requirements.txt

                        if [ -d tests ]; then
                            python -m unittest discover -s tests -v
                        else
                            echo "No tests directory found."
                        fi
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                container('docker') {
                    dir(env.APP_DIR) {
                        withEnv(['DOCKER_HOST=tcp://127.0.0.1:2375']) {
                            sh '''
                            set -ex

                            for i in $(seq 1 20); do
                                docker version >/dev/null 2>&1 && break
                                echo "Waiting for Docker daemon..."
                                sleep 2
                            done

                            docker build -t prashant260/mew-app:${IMAGE_TAG} .
                            '''
                        }
                    }
                }
            }
        }

        stage('Push Docker Image') {
            when {
                expression {
                    return env.DOCKER_CREDENTIALS_ID?.trim()
                }
            }
            steps {
                container('docker') {
                    dir(env.APP_DIR) {
                        withEnv(['DOCKER_HOST=tcp://127.0.0.1:2375']) {
                            withCredentials([
                                usernamePassword(
                                    credentialsId: env.DOCKER_CREDENTIALS_ID,
                                    usernameVariable: 'DOCKER_USER',
                                    passwordVariable: 'DOCKER_PASS'
                                )
                            ]) {
                                sh '''
                                set -ex

                                for i in $(seq 1 20); do
                                    docker version >/dev/null 2>&1 && break
                                    echo "Waiting for Docker daemon..."
                                    sleep 2
                                done

                                echo "$DOCKER_PASS" | docker login \
                                  -u "$DOCKER_USER" \
                                  --password-stdin

                                docker push prashant260/mew-app:${IMAGE_TAG}
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('Update Helm Chart') {
            steps {
                container('python') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: env.GITHUB_CREDENTIALS_ID,
                            usernameVariable: 'GIT_USER',
                            passwordVariable: 'GIT_TOKEN'
                        )
                    ]) {
                        sh '''
                        set -ex

apt-get update
apt-get install -y git

git --version

git config --global user.email "jenkins@local"
git config --global user.name "Jenkins"

sed -i "s/tag:.*/tag: ${IMAGE_TAG}/" helm/mew-app/values.yaml

git add helm/mew-app/values.yaml

git commit -m "Update image tag to ${IMAGE_TAG}" || true

git remote set-url origin https://${GIT_USER}:${GIT_TOKEN}@github.com/Prashant260/k8s-app.git

git push origin HEAD:main
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            container('python') {
                sh '''
                rm -rf app/.venv || true
                '''
            }
            deleteDir()
        }
    }
}