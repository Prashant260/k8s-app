pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent
spec:
  containers:
  - name: jnlp
    image: jenkins/inbound-agent:latest
    args:
    - $(JENKINS_SECRET)
    - $(JENKINS_NAME)

  - name: python
    image: python:3.12-slim
    command:
    - cat
    tty: true
'''
        }
    }

    environment {
        APP_DIR = "app"

        IMAGE_REPO = "prashant260/mew-app"
        IMAGE_TAG = "${BUILD_NUMBER}"

        DEPLOY_NAMESPACE = "pakistan"

        KUBE_CREDENTIALS_ID = "kubeconfig"
        DOCKER_CREDENTIALS_ID = "DOCKER_CREDENTIALS_ID"

        DEPLOY_TO_K8S = "false"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Debug Workspace') {
            steps {
                container('python') {
                    sh '''
                    echo "WORKSPACE=$WORKSPACE"

                    pwd

                    ls -la

                    echo "Repository Tree"

                    find . -maxdepth 3
                    '''
                }
            }
        }

       stage('Run Tests') {
    steps {
        container('python') {
            dir('app') {
                sh '''
                set -ex

                pwd
                ls -la

                # Remove any committed virtual environments
                rm -rf .venv
                rm -rf venv

                python3 -m venv .venv

                . .venv/bin/activate

                python -m pip install --upgrade pip

                pip install -r requirements.txt

                if [ -d tests ]; then
                    python -m unittest discover -s tests -v
                else
                    echo "No tests directory found."
                fi
                '''
            }
        }
    }
}

        stage('Build Docker Image') {
            steps {
                container('python') {
                    dir('app') {
                        sh '''
                set -ex

                apt-get update
                apt-get install -y --no-install-recommends docker.io

                echo "PATH=$PATH"

                which docker || true
                command -v docker || true

                ls -l /usr/bin/docker || true
                ls -l /usr/sbin/docker || true
                ls -l /usr/local/bin/docker || true

                /usr/bin/docker --version || true

                /usr/bin/docker version || true
                docker --version
                
                docker build -t mew-app:latest.
                        '''
                    }
                }
            }
        }

        stage('Push Docker Image') {
            when {
                expression {
                    return env.DOCKER_CREDENTIALS_ID?.trim()
                }
            }

            steps {
                container('python') {
                    dir('app') {
                        withCredentials([
                            usernamePassword(
                                credentialsId: env.DOCKER_CREDENTIALS_ID,
                                usernameVariable: 'DOCKER_USER',
                                passwordVariable: 'DOCKER_PASS'
                            )
                        ]) {
                            sh '''
                            echo "$DOCKER_PASS" | docker login \
                              -u "$DOCKER_USER" \
                              --password-stdin

                            docker push mew-app:latest
                            '''
                        }
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            when {
                expression {
                    return env.DEPLOY_TO_K8S == "true"
                }
            }

            steps {
                container('python') {
                    dir('app') {
                        withCredentials([
                            file(
                                credentialsId: env.KUBE_CREDENTIALS_ID,
                                variable: 'KUBECONFIG'
                            )
                        ]) {
                            sh '''
                            apt-get update

                            apt-get install -y curl

                            curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

                            export KUBECONFIG=$KUBECONFIG

                            helm upgrade --install mew-app ./helm/mew-app \
                              --namespace ${DEPLOY_NAMESPACE} \
                              --create-namespace \
                              --set image.repository=${IMAGE_REPO} \
                              --set image.tag=${IMAGE_TAG}
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            container('python') {
                sh '''
                rm -rf app/.venv || true
                '''
            }

            deleteDir()
        }
    }
}